{
  "name": "spielwirbel",
  "version": "1.0.0",
  "description": "Spielwirbel: a web app to manage games, run voting sessions and track ratings.",
  "type": "commonjs",
  "main": "server.js",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "start:env": "node --env-file-if-exists=.env server.js",
    "build": "node scripts/build.js",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage",
    "coverage:ci": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-functions=85 --test-coverage-branches=80",
    "lint": "eslint .",
    "check:syntax": "find . -path ./node_modules -prune -o -path ./data -prune -o -path ./dist -prune -o -name '*.js' -print0 | xargs -0 -n1 node --check",
    "migrate": "knex migrate:latest",
    "migrate:make": "knex migrate:make",
    "migrate:rollback": "knex migrate:rollback",
    "session-cost": "node scripts/session-cost.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@simplewebauthn/server": "^13.3.3",
    "argon2": "^0.45.1",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "multer": "^2.3.0",
    "nodemailer": "^9.1.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "supertest": "^7.2.2"
  }
}

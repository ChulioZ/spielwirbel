# Environment variables for Spielwirbel. Copy this file to `.env` and fill in
# the values you need, then start the server with `npm run start:env` (Node
# loads `.env` via --env-file-if-exists; a missing `.env` is fine).
#
# `.env` is gitignored — never commit real secrets. Everything here is OPTIONAL:
# the app runs fully with none of these set.

# HTTP port (default 3000).
# PORT=3000

# Where all user data lives (default ./data).
# DATA_DIR=./data

# Persistence backend (issue #127). Unset (the default) uses the local JSON file
# store at DATA_DIR/data.json — zero-dependency, right for local/home use. Set
# DATABASE_URL to a PostgreSQL connection string to use Postgres instead (the
# stateless-app-tier path for a hosted deployment); the app ensures its schema on
# startup. DATABASE_SSL=true enables TLS to the DB (managed Postgres usually needs
# it; a local/CI container does not).
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DATABASE_SSL=true

# Cover-image storage (issue #128). Unset (the default) stores cover images as
# files under DATA_DIR/uploads. Set S3_BUCKET to use S3-compatible object storage
# instead — the stateless-app-tier path so uploads survive an ephemeral/scaled
# host. Only the /uploads/<key> path is stored in the DB either way; the app
# streams objects back through /uploads (kept behind the auth gate). Works with
# AWS S3, Cloudflare R2, Backblaze B2, MinIO, etc. Credentials are optional: if
# S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY are unset, the AWS default provider chain
# (AWS_* env, IAM role) is used. Set S3_ENDPOINT for non-AWS stores (and usually
# S3_FORCE_PATH_STYLE=true for MinIO). S3_PREFIX namespaces keys in a shared bucket.
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=

# Trust an upstream reverse proxy (for TLS termination). Set it to the NUMBER OF
# PROXY HOPS between the internet and this container, so the real client IP is
# read from X-Forwarded-For and rate limiting keys on it. The number is
# deployment-specific: Railway is 2 (see docs/deploy-railway.md). Leave unset for
# a direct deployment. (default: off)
#
# Get the number right — too LOW and req.ip resolves to your own proxy, so every
# visitor behind it shares one rate-limit bucket. Verify after setting it: make a
# request and check the `ip` field of the request log line equals your own public
# address. Avoid `true` (trusts the whole chain, so a client can spoof
# X-Forwarded-For and evade the limits entirely).
# TRUST_PROXY=2

# Canonical-host redirect (issue #230). When the app is reachable at several
# domains on one host (all serving the same DB), 301 the branded non-canonical
# ones onto a single canonical origin. CANONICAL_HOST is the target (default
# spielwirbel.app); REDIRECT_HOSTS is the comma-separated allowlist of hosts to
# redirect (default: spielwirbel.de,www.spielwirbel.de,spielwirbel.com,
# www.spielwirbel.com). Only those hosts redirect — the canonical host,
# *.up.railway.app, and Railway's health-check host are always left alone. Set
# REDIRECT_HOSTS empty to disable. Defaults are inert on any non-branded host, so
# a local/self-hosted deployment needs to touch these only to point them at its
# own domains.
# CANONICAL_HOST=spielwirbel.app
# REDIRECT_HOSTS=spielwirbel.de,www.spielwirbel.de,spielwirbel.com,www.spielwirbel.com

# Rate-limit ceiling, per IP: requests per 15 min (default 1000).
# RATE_LIMIT_MAX=1000

# Contact form POST (issue #224): messages one IP may send per 15 min (default 5),
# on top of the global ceiling above. Deliberately low — the endpoint is public
# (reachable without login) and sends real e-mail.
# CONTACT_RATE_LIMIT_MAX=5

# Impressum / legal identity (issues #224/#134): the postal address and contact
# e-mail the legal pages (/impressum, /datenschutz) publish — for the hosted
# instance, the rented operator service address and the public mailbox.
# IMPRESSUM_ADDRESS may be multi-line (real newlines or \n escapes). While
# either var is unset the legal pages answer 404, and the public site footer
# (Kontakt + legal links) stays hidden: it renders only when BOTH vars are set
# AND mail is configured (SMTP_HOST + SMTP_USER + SMTP_PASS + MAIL_FROM) — all-or-nothing, so a
# half-configured instance shows no public face rather than a broken one
# (GET /api/config).
# IMPRESSUM_ADDRESS=
# IMPRESSUM_EMAIL=

# Support link (issue #173): the operator's donation page. When set, the app
# shows a heart button in the top bar that opens a small sheet whose only
# action is a plain link to this URL (new tab; no payment code, no embedded
# third-party widget). Unset (the default) the button does not exist — a
# self-hosted instance never advertises the operator's donation page. The
# hosted instance points this at its Ko-fi page (decision on #173); the value
# is opaque to the app, so any URL works.
# DONATE_URL=https://ko-fi.com/yourpage

# Per-tenant quotas & abuse controls (issue #139). These bound cost/abuse in the
# public multi-tenant mode and are ENFORCED ONLY when ACCOUNTS_ENABLED=true — with
# accounts off they are inert. MAX_ROUNDS_PER_TENANT:
# rounds one account may own (default 10). MAX_GAMES_PER_ROUND: games (active +
# retired) one round may hold (default 1000). MAX_TAGS_PER_ROUND: custom tags one
# round may define (default 30, issue #238). MAX_MEMBERS_PER_ROUND: member seats one
# round may hold, counting the creator's own and any invited account's (default 50,
# issue #563). Friendship caps (per ACCOUNT, issue
# #325): MAX_FRIENDS_PER_USER — accepted friends one account may hold (default
# 500); MAX_FRIEND_REQUESTS_PER_USER — open OUTGOING friend requests at once
# (default 50, the anti-spam control). MAX_FEED_EVENTS — Freundeskreis feed events
# kept per account, oldest pruned on write (default 50). MAX_INBOX_ITEMS — inbox
# notifications kept per account, oldest pruned on write (default 100).
# MAX_ROUNDS_PER_TENANT=10
# MAX_GAMES_PER_ROUND=1000
# MAX_TAGS_PER_ROUND=30
# MAX_MEMBERS_PER_ROUND=50
# MAX_FRIENDS_PER_USER=500
# MAX_FRIEND_REQUESTS_PER_USER=50
# MAX_FEED_EVENTS=50
# MAX_INBOX_ITEMS=100

# Authentication gate (issue #129). Set AUTH_PASSWORD to require a single shared
# login for the whole app; unset (the default) leaves a bare local checkout
# fully open — the production deployment sets this. SESSION_SECRET signs the
# session cookie — set it to a long random string in a real deployment; if
# unset it falls back to AUTH_PASSWORD. AUTH_RATE_LIMIT_MAX caps auth-route
# requests per IP per 15 min (default 100).
# AUTH_PASSWORD=
# SESSION_SECRET=
# AUTH_RATE_LIMIT_MAX=100

# REGISTER_RATE_LIMIT_MAX (#448) caps POST /api/account/register per IP per
# 15 min (default 10), on top of AUTH_RATE_LIMIT_MAX. Registration is the one
# unauthenticated endpoint that mails a stranger's address on first contact, so
# it gets a tighter cap than the rest of the account routes. Sized for a NAT'd
# household or a table of friends signing up together, not for one person.
# REGISTER_RATE_LIMIT_MAX=10

# User accounts (issue #135): the token-first account model (register, e-mail
# verification, login with access/refresh tokens, password reset), meant to
# eventually replace the shared-password gate. Tenancy (#136) and the
# onboarding UI (#138) have both shipped, so the feature is complete — OFF by
# default is now a deliberate ops choice (opening public sign-up needs the
# legal pack first, see docs/production-readiness.md §9/§12), not a
# dependency wait. Set ACCOUNTS_ENABLED=true AND a strong SESSION_SECRET (it
# signs the access tokens) to expose /api/account.
# ACCOUNTS_ENABLED=true
#
# LAYERED mode (issue #266): AUTH_PASSWORD and accounts can now run at the SAME
# time. With AUTH_PASSWORD + ACCOUNTS_ENABLED + SESSION_SECRET all set, the
# instance stays sealed behind the shared password (register/login sit behind it,
# so it is NOT public sign-up) while everyone inside uses real accounts. This is
# the recommended go-live path: run layered for a while, then just REMOVE
# AUTH_PASSWORD to open public registration (docs/deploy-railway.md). SESSION_SECRET
# must then be its OWN dedicated secret, never falling back to AUTH_PASSWORD (the
# shared password is known to the whole group and must not be able to forge tokens).

# Guest demo mode (issue #427): let a visitor try the app WITHOUT registering.
# Needs ACCOUNTS_ENABLED as well — a demo is a real (throwaway) account, so it
# cannot work in the shared-password or open modes. With it set, the landing page
# offers a demo button next to "register" and POST /api/account/demo mints a
# pre-seeded account + tenant; unset, that endpoint 404s and the button is not
# rendered, so a self-hosted instance is unchanged.
#
# The demo is disposable by construction: no password identity (it can never be
# logged back into), no friend requests or round invitations, and registering
# afterwards starts a FRESH account — nothing carries over. Expired demos are
# deleted with their rounds and any uploaded covers by the background job in
# lib/scheduler.js, which server.js starts.
#
# DEMO_TTL_HOURS: how long a demo lives before it is purged (default 24).
# MAX_LIVE_DEMOS: how many may exist at once (default 100). This is the real
#   bound — the per-IP limiter below only caps one caller's convenience, while an
#   IP-rotating caller would otherwise mint rows without limit. At the ceiling the
#   endpoint answers 503 demo_unavailable instead of minting.
# MAX_LIVE_DEMOS_PER_IP: how many LIVE demos one source may hold at once
#   (default 3, issue #502). Distinct from the rate limiter below: that bounds how
#   FAST one caller mints, this bounds how many they can hold — leaving a demo
#   without ending it frees no slot, so start/leave/start again would otherwise
#   strand them one at a time until the pool is empty. Not 1, so a household or
#   office behind one NAT can still run two at once. Needs a correct TRUST_PROXY
#   (a hop COUNT) or req.ip is the proxy and this becomes one shared bucket.
# DEMO_RATE_LIMIT_MAX: demos per IP per 15 min (default 5), on top of
#   AUTH_RATE_LIMIT_MAX. Tighter than registration because one call also writes a
#   whole seeded round.
# DEMO_ENABLED=true
# DEMO_TTL_HOURS=24
# MAX_LIVE_DEMOS=100
# MAX_LIVE_DEMOS_PER_IP=3
# DEMO_RATE_LIMIT_MAX=5

# Operator moderation surface (issue #268): /admin.html + /api/admin — look a
# reported cover image up to its owning game/round/tenant, take it down, suspend
# or restore an account, and read the action log. This is what makes the reactive
# DSA duties performable once public registration opens. Unset (the default) the
# entire surface 404s and the instance is unchanged.
#
# ADMIN_PASSWORD must be a SEPARATE, strong secret — deliberately NOT the same
# value as AUTH_PASSWORD. AUTH_PASSWORD is shared with everyone using the
# instance, while these powers cross tenant boundaries (read any tenant's rows,
# delete any image, disable any account); reusing it would hand that to the whole
# group and would also make an ordinary app session authenticate the panel. See
# lib/admin.js and .claude/rules/admin-moderation-surface.md.
#
# ADMIN_SESSION_SECRET signs the admin session cookie; if unset it falls back to
# SESSION_SECRET, then to ADMIN_PASSWORD. Login attempts share the
# AUTH_RATE_LIMIT_MAX limiter above.
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=

# Outbound transactional e-mail for the account flows: plain SMTP submission.
# Unset (the default): nothing is sent — messages are logged and kept in an
# in-memory outbox, which is what dev and the test suite use. MAIL_FROM must be
# an address that exists on the sending account (mailbox.org, like most hosts,
# refuses a From that is not one of the account's addresses or aliases) and on a
# domain with SPF + DKIM published. SMTP_PORT defaults to 465 (implicit TLS);
# 587 is used with STARTTLS. APP_BASE_URL builds the links inside the mails
# (default http://localhost:PORT) — keep the origin under ~28 characters, since
# the mailed one-time link must fit on one 76-column quoted-printable line or
# clients show it cut in half (#434, .claude/rules/mailed-links-must-fit-one-qp-line.md).
#
# Deliberately provider-neutral names: any SMTP host works, and #440 changed
# provider three times in one day. Production sends through the operator's own
# mailbox (mailbox.org) — no separate delivery processor, so nothing can inject
# tracking pixels or rewrite links, and the privacy policy has one fewer
# recipient to name. Two things to know if you point this elsewhere: use an
# app-specific password scoped to SMTP only (never the account password — an
# IMAP-capable credential in an env var exposes the whole mailbox), and note
# that Railway blocks outbound SMTP below the Pro plan.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=no-reply@example.com
# SMTP_PASS=
# MAIL_FROM=no-reply@example.com
# MAIL_FROM_NAME=Spielwirbel
# APP_BASE_URL=https://example.com

# MAIL_DAILY_MAX (#448) is a global circuit breaker on outbound mail: once this
# many messages have been sent in one UTC day, further sends are refused and
# logged (`mail_daily_budget_exhausted`) instead of delivered. It protects the
# operator mailbox's own sending quota — production sends through a mailbox, not
# an ESP, so there is no headroom, and running the quota dry stops verification
# mail, i.e. signup, for everyone. Set it below your provider's real daily limit.
# The count is per process and in memory, so it resets on restart and each
# instance carries its own budget (same caveat as the rate limiters — see #215).
# MAIL_DAILY_MAX=200

# Contact form (issue #224): where POST /api/contact delivers messages. Falls
# back to MAIL_FROM when unset. On a production deploy, mail MUST be configured
# (SMTP_HOST + SMTP_USER + SMTP_PASS + MAIL_FROM) or the endpoint fails loud (502) instead of
# silently dropping messages into the in-memory outbox.
# CONTACT_TO=hello@example.com

# Observability (issue #132). Structured request/error logs go to stdout as JSON.
# LOG_LEVEL controls verbosity: silent | error | warn | info (default info).
# LOG_LEVEL=info
# Optional error alerting: if set, the central error handler POSTs a compact,
# personal-data-free notification (method, path, message) to this webhook on any
# unexpected 500 — e.g. a Slack/Discord incoming webhook. Leave unset to disable.
# Note the payload is {"text": …}: Slack/Mattermost/Google Chat take it as is,
# Discord needs {"content": …} and ntfy a raw body, so those need a code change.
# A non-2xx reply is logged at warn (#462) rather than vanishing — but the URL is
# never logged, so it is safe for it to carry a token.
# The forwarded text includes the real request path, which can carry round ids:
# a third-party destination therefore becomes a recipient of personal data and
# needs the privacy-policy/VVT work in .claude/rules/keep-legal-docs-current.md.
# ERROR_WEBHOOK_URL=

# No env var configures the probe endpoints — GET /healthz (liveness) and
# GET /readyz (readiness; 503 when the data backend is unreachable) are always
# mounted, unauthenticated and exempt from rate limiting. Point an external
# uptime monitor at them; see docs/deploy-railway.md "Monitoring".

# BoardGameGeek application token (issue #117). BGG's XML API needs a registered
# application and a Bearer token — create one under
# https://boardgamegeek.com/applications → "Tokens". Without it the board-game
# lookup silently returns no results (the other four providers are unaffected);
# the operator status panel flags the missing token.
# BGG_API_TOKEN=

# Add-game lookup provider locales/regions — the FALLBACK only (defaults shown).
#
# Since #505 the four digital storefronts answer in the requesting user's own UI
# language: the client sends the active locale and each provider maps it onto
# that store's own spelling (de-de / en-us / fr-fr / …) through a closed table in
# lib/providers/locales.js. So these four are no longer what a normal request
# uses — they are what a self-hosted instance can pin for a language none of the
# stores serves. BoardGameGeek is deliberately not localized (it answers with the
# name that matched the query), so it has no such variable.
# PSSTORE_LOCALE=de-de
# STEAM_CC=de
# STEAM_LOCALE=german
# NINTENDO_LOCALE=de
# XBOX_LOCALE=de-de
